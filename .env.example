# Public Supabase project URL, e.g. https://abcdxyz.supabase.co
# (Hostinger wizard may also set SUPABASE_URL — both work)
NEXT_PUBLIC_SUPABASE_URL=

# Server-only secret / service_role key from Supabase → Settings → API
# Never expose this to the browser or commit it.
# Hostinger's wizard usually does NOT add this — set it manually.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin login
ADMIN_PASSWORD=
